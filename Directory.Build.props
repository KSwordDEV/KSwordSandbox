<Project>
  <PropertyGroup>
    <!--
      Keep SDK-style projects from accidentally compiling generated/intermediate
      .cs files under the repository. Do not exclude a whole drive/root: a
      portable source package may legitimately be extracted to D:\Temp, and an
      absolute D:\Temp\** exclude makes every source file disappear (CS5001).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**;**\.vs\**;**\x64\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\bin\**\*.cs;**\obj\**\*.cs;**\.vs\**\*.cs;**\x64\**\*.cs" />
    <None Remove="**\bin\**;**\obj\**;**\.vs\**;**\x64\**" />
  </ItemGroup>
</Project>
